# Provider: yahooDelayed (free) or kite (paid, live)
PROVIDER=yahooDelayed
# How often to refresh (ms). Keep >= 60000 on the free feed.
REFRESH_MS=60000
# Lock CORS to your deployed UI origin in production (optional).
# Comma-separated. Vercel previews of the same project and any localhost port
# are accepted on top of what is listed here — see the README.
UI_ORIGIN=*
# Override the derived Vercel project slug used to match preview deploys.
# UI_ORIGIN_PREVIEW_PREFIX=trinetra-web
# Escape hatch: a regex matched against the whole origin string.
# UI_ORIGIN_REGEX=
# Accounts. Unset = single-user mode: every request is the owner, and anyone
# with the URL has full access. Set it and the schema is created on boot, the
# first signup becomes the owner, and every later signup needs an invite.
# Neon or Supabase (Session pooler — the direct host is IPv6-only). With this
# set, UI_ORIGIN must name a real origin: "*" refuses to boot.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
# Connections in the pool. 5 suits Render free; raise only within the host's cap.
# DB_POOL_MAX=5

# --- Kite only ---
# KITE_API_KEY=
# KITE_ACCESS_TOKEN=
