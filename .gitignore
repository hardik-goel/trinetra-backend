# deps
node_modules/

# secrets — .env.example is the committed template
.env

# runtime state, written by the server at run time. The committed seeds
# (universe.json, fundamentals.json, config.default.json) are the durable
# versions; these are per-deploy and wiped on Render's free tier anyway.
universe.runtime.json
fundamentals.cache.json
config.json

# The user's own records — signal history, paper trades, IPO applications.
# Not committed: they are personal trading data, not project state. See the
# README on making these survive a redeploy; on an ephemeral host they do not.
data/

# macOS
.DS_Store
